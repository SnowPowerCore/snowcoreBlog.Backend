<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- PublishTrimmed intentionally OFF: Stripe.net relies on reflection-based JSON
         serialization of its option/entity models and is not trim-safe. -->
    <UserSecretsId>f4650b45-fed6-4a9a-9b97-2918092e0f30</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql" />
    <PackageReference Include="FastEndpoints" />
    <PackageReference Include="FastEndpoints.Security" />
    <PackageReference Include="FastEndpoints.Generator">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FastEndpoints.Swagger" />
    <PackageReference Include="FastEndpoints.OpenTelemetry" />
    <PackageReference Include="Fody">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ConfigureAwait.Fody" />
    <PackageReference Include="MassTransit.RabbitMQ" />
    <PackageReference Include="Marten" />
    <PackageReference Include="Marten.SourceGenerator" PrivateAssets="all" />
    <PackageReference Include="MinimalStepifiedSystem.Core" />
    <PackageReference Include="MinimalStepifiedSystem.SourceGen" />
    <PackageReference Include="Riok.Mapperly">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Stripe.net" />
  </ItemGroup>

  <ItemGroup>
    <None Update="**/FodyWeavers.*" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="snowcoreBlog.ServiceDefaults" />
    <PackageReference Include="snowcoreBlog.PublicApi" />
    <PackageReference Include="snowcoreBlog.Backend.Infrastructure" />
    <ProjectReference Include="..\..\Stripe.Core\snowcoreBlog.Backend.Stripe.Core.csproj" />
  </ItemGroup>

</Project>
