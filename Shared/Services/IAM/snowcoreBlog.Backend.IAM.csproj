<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishTrimmed>true</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
    <UserSecretsId>f4650b45-fed6-4a9a-9b97-2918092e0f30</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql" />
    <PackageReference Include="Fido2.AspNet" />
    <PackageReference Include="Marten" />
    <PackageReference Include="Marten.SourceGenerator" PrivateAssets="all" />
    <PackageReference Include="Fody">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ConfigureAwait.Fody" />
    <PackageReference Include="MassTransit.RabbitMQ" />
    <PackageReference Include="Otp.NET" />
    <PackageReference Include="Sodium.Core" />
    <PackageReference Include="Riok.Mapperly">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="snowcoreBlog.Backend.Email.Core" />
    <PackageReference Include="snowcoreBlog.Backend.AspireYarpGateway.Core" />
  </ItemGroup>

  <ItemGroup>
    <None Update="**/FodyWeavers.*" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Features\Admin\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="snowcoreBlog.ServiceDefaults" />
    <PackageReference Include="snowcoreBlog.Backend.Infrastructure" />
    <ProjectReference Include="..\..\IAM.Core\snowcoreBlog.Backend.IAM.Core.csproj" />
  </ItemGroup>

</Project>