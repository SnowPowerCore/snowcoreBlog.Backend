{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "rabbitmq": "amqp://guest:guest@localhost:5672/",
    "db-documents-entities": "Host=localhost;Database=snowcore_blog_documents;Username=postgres;Password=postgres"
  },
  "Documents": {
    "PublicBaseUrl": "https://localhost/api/documents",
    "Storage": {
      "RootPath": "document-content"
    },
    "UploadLimits": {
      "MaxSizeBytes": 20971520,
      "AllowedContentTypes": [
        "application/pdf",
        "image/png",
        "image/jpeg",
        "image/webp",
        "text/plain",
        "text/markdown",
        "application/json"
      ]
    }
  }
}
